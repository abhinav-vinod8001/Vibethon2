{
  "name": "jobsathi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts next.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/matching.test.ts",
    "test:integration": "node tests/integration.mjs",
    "test:standalone": "node tests/integration.mjs --standalone",
    "test:vercel-build": "node tests/vercel-build.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:database": "node --test tests/database.test.mjs",
    "format": "prettier --write src scripts tests next.config.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pdfkit": "0.17.2",
    "postgres": "3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pdfkit": "0.17.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
