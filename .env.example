# Copy to .env.local. Use your staging HTTPS origin on Vercel.
APP_URL=http://localhost:3000

# Supabase Dashboard -> Connect. The publishable key is not an admin secret.
# User sessions and Row Level Security protect access to application records.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional migration command only: Connect -> Session pooler (URL-encode password).
# Not needed by the web app, or when SQL is applied through the SQL Editor.
SUPABASE_DB_URL=

# Google Client ID/Secret belong in Supabase Authentication -> Google settings.
# No NextAuth secret, Turso token, or Supabase admin key is needed by this app.

# Optional AI/voice features. These credentials must stay server-only.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
