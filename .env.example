# Copy to .env.local for development. All values are server-only.
# Use a hosted libSQL URL on Vercel; never use a local file for serverless data.
DATABASE_URL=file:.data/jobsathi.db
DATABASE_AUTH_TOKEN=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
SARVAM_API_KEY=
SARVAM_MODEL=saaras:v3
