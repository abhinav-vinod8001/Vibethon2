{
  "name": "jobsathi",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests scripts drizzle.config.ts next.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --experimental-strip-types --test tests/matching.test.ts",
    "test:integration": "node tests/integration.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:generate": "drizzle-kit generate",
    "format": "prettier --write src scripts tests drizzle.config.ts next.config.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-auth": "4.24.15",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "prettier": "3.6.2",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  }
}
